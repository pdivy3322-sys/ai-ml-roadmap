```python
"""
PYTHON DATA STRUCTURES
Topic: List, Set, and Dictionary Practicals

Description:
This file contains beginner-friendly Python programs
to understand and practice common data structure operations.
"""


# ============================================================
#                     1. LIST PRACTICALS
# ============================================================


# Q1. Access and Update List
# Aim: To access and update an element in a list.

my_list = ["shiva", "parvati", "hanuman"]

print(my_list[0])

my_list[1] = "ram"
print(my_list)


# Q2. Add Element using append()
# Aim: To add an element at the end of a list.

my_list.append("sita")
print(my_list)


# Q3. Remove Element using remove()
# Aim: To remove a specific element from a list.

my_list.remove("hanuman")
print(my_list)


# Q4. Insert Element using insert()
# Aim: To insert an element at a specific index in a list.

my_list.insert(0, "krishna")
print(my_list)


# Q5. Remove Element using pop()
# Aim: To remove an element from a specific index in a list.

my_list.pop(1)
print(my_list)


# Q6. Sort List in Ascending Order
# Aim: To arrange list elements in ascending order.

numbers = [8, 5, 3, 2, 5, 7, 1, 50]

numbers.sort()
print(numbers)


# Q7. Sort List in Descending Order
# Aim: To arrange list elements in descending order.

numbers = [8, 5, 3, 2, 5, 7, 1, 50]

numbers.sort(reverse=True)
print(numbers)


# Q8. Reverse a List
# Aim: To reverse the order of elements in a list.

numbers = [8, 5, 3, 2, 5, 7, 1, 50]

numbers.reverse()
print(numbers)


# Q9. Find Length of a List
# Aim: To find the total number of elements in a list.

numbers = [8, 5, 3, 2, 5, 7, 1, 50]

print("Length of list:", len(numbers))


# Q10. Count Occurrences of an Element
# Aim: To count how many times an element appears in a list.

numbers = [8, 5, 3, 2, 5, 7, 1, 50]

print("Count of 5:", numbers.count(5))


# ============================================================
#                     2. SET PRACTICALS
# ============================================================


# Q1. Create and Display a Set
# Aim: To create a set and display its elements.

numbers = {1, 2, 3, 4, 5}

print(numbers)


# Q2. Remove Duplicate Elements
# Aim: To understand how a set automatically removes duplicates.

numbers = {1, 2, 3, 3, 4, 5, 1}

print(numbers)


# Q3. Add an Element using add()
# Aim: To add a new element to a set.

numbers = {1, 2, 3, 4, 5}

numbers.add(6)
print(numbers)


# Q4. Remove an Element using remove()
# Aim: To remove a specific element from a set.

numbers = {1, 2, 3, 4, 5, 6}

numbers.remove(6)
print(numbers)


# Q5. Remove an Element using discard()
# Aim: To remove an element from a set using discard().

numbers = {1, 2, 3, 4, 5}

numbers.discard(3)
print(numbers)


# Q6. Remove an Element using pop()
# Aim: To remove an arbitrary element from a set.

numbers = {1, 2, 3, 4, 5}

numbers.pop()
print(numbers)


# Q7. Iterate Through a Set
# Aim: To access and display set elements using a for loop.

numbers = {1, 2, 3, 4}

for number in numbers:
    print(number)


# Q8. Perform Set Operations
# Aim: To perform union, intersection, and difference operations.

set1 = {1, 2, 3}
set2 = {3, 4, 5}

print("Union:", set1 | set2)
print("Intersection:", set1 & set2)
print("Difference:", set1 - set2)


# ============================================================
#                  3. DICTIONARY PRACTICALS
# ============================================================


# Q1. Create and Display a Dictionary
# Aim: To create a dictionary containing key-value pairs.

student = {
    "name": "Rahul",
    "age": 20,
    "course": "Python"
}

print(student)


# Q2. Access Value using a Key
# Aim: To retrieve a student's name using its dictionary key.

student = {
    "name": "Rahul",
    "age": 20,
    "course": "Python"
}

print(student["name"])


# Q3. Access Age using a Key
# Aim: To retrieve a student's age using its dictionary key.

student = {
    "name": "Rahul",
    "age": 20,
    "course": "Python"
}

print(student["age"])


# Q4. Update a Dictionary Value
# Aim: To update an existing value in a dictionary.

student = {
    "name": "Rahul",
    "age": 20,
    "course": "Python"
}

student["age"] = 21
print(student)


# Q5. Add and Update Elements using update()
# Aim: To update an existing key and add a new key-value pair.

student = {
    "name": "Ram",
    "age": 19,
    "course": "CSE"
}

student.update({
    "age": 20,
    "city": "Mumbai"
})

print(student)


# Q6. Remove an Element using pop()
# Aim: To remove a key-value pair using its key.

student = {
    "name": "Rahul",
    "age": 19,
    "course": "Python"
}

student.pop("course")
print(student)


# Q7. Delete an Element using del
# Aim: To delete a key-value pair using the del statement.

student = {
    "name": "Rahul",
    "age": 19,
    "course": "Python"
}

del student["course"]
print(student)


# Q8. Clear a Dictionary
# Aim: To remove all key-value pairs from a dictionary.

student = {
    "name": "Rahul",
    "age": 19,
    "course": "Python"
}

student.clear()
print(student)


# Q9. Iterate Through a Dictionary
# Aim: To display dictionary keys and their corresponding values.

student = {
    "name": "Rahul",
    "age": 19,
    "course": "Python"
}

for key in student:
    print(key, ":", student[key])


# Q10. Access Dictionary Keys using keys()
# Aim: To retrieve and display all dictionary keys.

student = {
    "name": "Rahul",
    "age": 19,
    "course": "Python"
}

for key in student.keys():
    print(key)


# Q11. Access Dictionary Values using values()
# Aim: To retrieve and display all dictionary values.

student = {
    "name": "Rahul",
    "age": 19,
    "course": "Python"
}

for value in student.values():
    print(value)


# Q12. Access Key-Value Pairs using items()
# Aim: To retrieve and display dictionary keys and values together.

student = {
    "name": "Rahul",
    "age": 19,
    "course": "Python"
}

for key, value in student.items():
    print(key, ":", value)


# ============================================================
#                       END OF FILE
# ============================================================
