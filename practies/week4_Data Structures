#PYTHON DATA STRUCTURES
#LIST, SET AND DICTIONARY
#LIST PRACTICALS


# Q1. Access and Update List
# Aim: To access and update an element in a list.
my_list = ["shiva", "parvati", "hanuman"]

print(my_list[0])

my_list[1] = "ram"
print(my_list)


# Q2. Add Element using append()
# Aim: To add an element at the end of a list.

my_list.append("sita")
print(my_list)


# Q3. Remove Element using remove()
# Aim: To remove a specific element from a list.

my_list.remove("hanuman")
print(my_list)


# Q4. Insert Element using insert()
# Aim: To insert an element at a specific position in a list.

my_list.insert(0, "krishna")
print(my_list)


# Q5. Remove Element using pop()
# Aim: To remove an element from a specific index of a list.

my_list.pop(1)
print(my_list)


# Q6. Sort List in Ascending Order
# Aim: To arrange the elements of a list in ascending order.

numbers = [8, 5, 3, 2, 5, 7, 1, 50]

numbers.sort()
print(numbers)


# Q7. Sort List in Descending Order
# Aim: To arrange the elements of a list in descending order.

numbers = [8, 5, 3, 2, 5, 7, 1, 50]

numbers.sort(reverse=True)
print(numbers)


# Q8. Reverse List
# Aim: To reverse the order of elements in a list.

numbers = [8, 5, 3, 2, 5, 7, 1, 50]

numbers.reverse()
print(numbers)


# Q9. Find Length of List
# Aim: To find the total number of elements in a list.

numbers = [8, 5, 3, 2, 5, 7, 1, 50]

print(len(numbers))


# Q10. Count an Element
# Aim: To count the number of occurrences of an element in a list.

numbers = [8, 5, 3, 2, 5, 7, 1, 50]

print(numbers.count(5))


